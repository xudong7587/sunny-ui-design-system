{
  "name": "@xudong7587/sunny-ui-design-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.lib.json && node node_modules/vite/bin/vite.js build --mode library && node node_modules/vite/bin/vite.js build --mode demo",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "preview": "node node_modules/vite/bin/vite.js preview --outDir dist-demo --host 127.0.0.1"
  },
  "exports": {
    ".": {
      "types": "./dist-types/src/index.d.ts",
      "import": "./dist/sunny-ui.js"
    },
    "./styles.css": "./dist/appearance.css"
  },
  "files": [
    "dist",
    "dist-types",
    "skills"
  ],
  "peerDependencies": {
    "react": ">=18",
    "@phosphor-icons/react": "^2.1.10"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "packageManager": "pnpm@11.7.0"
}
